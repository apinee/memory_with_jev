# ==============================================================================
# Environment Configuration for Memory-Graph Chatbot with TypeSafe Jev Gate
# ==============================================================================

# Google Gemini API Key (Required for conversational agent)
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# TypeSafe Jev API Key (Required for System One decision gate)
# Endpoint: https://api.typesafe.ai/v1/systemone
# If left empty, the application will automatically run in heuristic MOCK mode.
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Optional Alternative Endpoints / Gateways
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# OPENROUTER_API_KEY=your_openrouter_api_key_here
